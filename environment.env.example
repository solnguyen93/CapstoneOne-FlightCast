# Copy to environment.env and fill in your own keys (environment.env is gitignored).
SECRET_KEY=any_long_random_string
DATABASE_URL='postgresql:///flightcast'
# Amadeus for Developers (https://developers.amadeus.com): API key and secret
CLIENT_ID=your_amadeus_api_key
CLIENT_SECRET=your_amadeus_api_secret
# Visual Crossing Weather (https://www.visualcrossing.com)
WEATHER_TOKEN=your_visual_crossing_key
